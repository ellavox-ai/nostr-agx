{
	"name": "@nostr-agx/tailscale",
	"version": "0.6.0",
	"description": "Opt-in Tailscale private-relay support for @nostr-agx/nostr: composable auth keys and a local tsnet SOCKS5 relay proxy.",
	"license": "MIT",
	"author": "Ellavox AI",
	"homepage": "https://www.ellavox.ai/elladex",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ellavox-ai/nostr-agx.git",
		"directory": "integrations/tailscale"
	},
	"bugs": {
		"url": "https://github.com/ellavox-ai/nostr-agx/issues"
	},
	"keywords": [
		"nip-agx",
		"nostr-agx",
		"nostr",
		"tailscale",
		"tsnet",
		"socks5",
		"private-relay"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"bin",
		"dist",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"build:launcher": "make -C launcher stage",
		"dev": "tsup --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run",
		"example:two-agents-auth-key": "tsx examples/two-agents-auth-key.ts",
		"example:two-agents-oauth": "tsx examples/two-agents-oauth.ts",
		"dummy-oauth:server": "tsx examples/dummy-oauth-server.ts",
		"dummy-oauth:client": "tsx examples/dummy-oauth-client.ts"
	},
	"peerDependencies": {
		"@nostr-agx/nostr": "^0.6.0"
	},
	"devDependencies": {
		"@nostr-agx/core": "workspace:*",
		"@nostr-agx/nostr": "workspace:*",
		"@types/node": "^26.4.0",
		"@types/ws": "^8.18.1",
		"socks-proxy-agent": "^10.1.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"ws": "^8.21.3"
	}
}
